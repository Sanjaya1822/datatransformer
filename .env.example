# =============================================================================
# Multi-Source Candidate Data Transformer & Reconciliation Platform
# Environment Configuration
# =============================================================================

# Persistence (SQLite fallback for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./datatransformer.db
# DATABASE_URL=postgresql://dt_user:dt_password@localhost:5432/datatransformer

# JWT Authentication & RBAC Secrets
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-at-least-32-chars-long-super-secret-key-12345
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default Seed Administrator Credentials (initialized on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@datatransformer.local

# Optional External AI Extraction (Extractor-Validator-Refiner)
# If left blank, system deterministically falls back to offline rule-based extraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Pipeline Defaults
CANDIDATE_MATCH_THRESHOLD=0.85
UNCERTAIN_MATCH_THRESHOLD=0.50
MAX_UPLOAD_SIZE_MB=10
